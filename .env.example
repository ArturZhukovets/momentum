# Copy to .env and fill in. Real environment variables win over this file.

BOT_TOKEN=
BOT_MODE=polling                  # polling | webhook

# Webhook mode only
WEBHOOK_BASE=https://89-125-51-9.sslip.io
WEBHOOK_PATH=/tg/change-me-random-segment
WEBHOOK_SECRET=                   # X-Telegram-Bot-Api-Secret-Token
WEB_HOST=0.0.0.0
WEB_PORT=8080

DB_PATH=data/momentum.db

# Required. JSON list of Telegram user ids allowed to use /admin.
# Admin access to other users' workouts is read-only.
ADMIN_USER_IDS=[123456789]
APP_TZ=Europe/Minsk
WEEKLY_GOAL=3
REPORT_HOUR=9
LOG_LEVEL=INFO
